# Copy to .env and fill in. Never commit real values.

# Resend API key, from https://resend.com/api-keys — used by the contact form's
# Server Action. Without it, submissions fail into the form's delivery error.
# Must also be set in the Vercel project's environment variables for production.
RESEND_API_KEY=

# Canonical origin, e.g. https://example.com. Optional on Vercel, which provides
# VERCEL_PROJECT_PRODUCTION_URL as a fallback. Used for OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=
